    eloict:hasCredits 6 ;
    eloict:belongsToPhase eloict:Phase2 ;
    eloict:belongsToSemester eloict:S1 ;
    eloict:hasCoordinator eloict:Y_Blancquaert ;
    eloict:hasLecturer eloict:Y_Blancquaert, eloict:E_Jacobs, eloict:K_Van_Assche .

