@prefix eloict: <http://odisee.be/eloict#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .


eloict:FrontendDesign a eloict:CourseUnit ;
    rdfs:label "Front-end Design"@nl ;
    eloict:courseCode "OGI06G" ;
    eloict:hasCredits 6 ;
    eloict:belongsToPhase eloict:Phase1 ;
    eloict:belongsToSemester eloict:S2 ;
    eloict:hasCoordinator eloict:D_De_Winne ;
    eloict:hasLecturer eloict:D_De_Winne ,
                        eloict:A_AbdulKhalil ,
                        eloict:R_DeWilde .

eloict:JavascriptDevelopment a eloict:CourseUnit ;
    rdfs:label "Javascript Development"@nl ;
    eloict:courseCode "OGI06H" ;
    eloict:hasCredits 6 ;
    eloict:belongsToPhase eloict:Phase1 ;
    eloict:belongsToSemester eloict:S2 ;
    eloict:requiresCourse eloict:FrontendDesign ;
    eloict:hasCoordinator eloict:B_Delrue ;
    eloict:hasLecturer eloict:B_Delrue .

eloict:BackendDevelopment a eloict:CourseUnit ;
    rdfs:label "Back-end Development"@nl ;
    eloict:courseCode "OGI05H" ;
