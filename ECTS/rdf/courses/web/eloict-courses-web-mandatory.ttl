    eloict:belongsToPhase eloict:Phase2 ;
    eloict:belongsToSemester eloict:S1 ;
    eloict:requiresCourse eloict:JavascriptDevelopment ;
    eloict:hasCoordinator eloict:J_Maervoet ;
    eloict:hasLecturer eloict:J_Maervoet ,
                        eloict:P_VanPeteghem .

eloict:FullstackIntroduction a eloict:CourseUnit ;
    rdfs:label "Full-stack Introduction"@nl ;
