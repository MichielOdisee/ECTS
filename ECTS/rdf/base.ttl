@prefix eloict: <http://odisee.be/eloict#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .


eloict:Phase1 a eloict:Phase ; rdfs:label "Phase 1"@nl .
eloict:Phase2 a eloict:Phase ; rdfs:label "Phase 2"@nl .
eloict:Phase3 a eloict:Phase ; rdfs:label "Phase 3"@nl .

eloict:S1 a eloict:Semester ; rdfs:label "Semester 1"@nl .
eloict:S2 a eloict:Semester ; rdfs:label "Semester 2"@nl .




eloict:requiresCourse a rdf:Property ; rdfs:label "verplicht voorafgaand vak"@nl .
eloict:recommendedBeforeCourse a rdf:Property ; rdfs:label "aanbevolen volgorde"@nl .
eloict:excludesCourse a rdf:Property ; rdfs:label "sluit uit"@nl .

eloict:courseCode a rdf:Property .
eloict:hasCredits a rdf:Property .
eloict:belongsToPhase a rdf:Property .
eloict:belongsToSemester a rdf:Property .
eloict:courseType a rdf:Property .
eloict:hasCoordinator a rdf:Property .
eloict:hasLecturer a rdf:Property .
eloict:teachesSkill a rdf:Property .